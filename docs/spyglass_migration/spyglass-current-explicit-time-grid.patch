+    tracking.iloc[15, 0] = np.nan
+    _, results = run_adapter(
+        family, True, tracking, spikes, marks, params, {"max_iter": 1}, [[0, 1]]
+    )
+    assert results.is_missing.any()
+    assert np.all(results.interval_labels.values == 0)
