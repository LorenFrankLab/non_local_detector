+"""Read-only actual make() source harness, stopping before persistence.
+
+Load candidate migration tests via importlib; pass that module as ``migration``.
+The only replacements are fetch-table inputs and the pre-persistence adapter
+capture. ``run_adapter`` can then run the captured inputs through real decoding.
+"""
+
+import copy
+from types import SimpleNamespace
+
+import numpy as np
+import pandas as pd
+
+
+class Observation:
+    def __init__(self, intervals):
+        self.intervals = (
+            None
+            if intervals is None
+            else np.asarray(intervals, float).reshape(-1, 2)
+        )
+        self.unknown_sources = ()
+
+    def contains(self, times):
+        times = np.asarray(times)
+        if self.intervals is None:
+            return np.ones(times.shape, bool)
+        result = np.zeros(times.shape, bool)
+        for start, stop in self.intervals:
+            result |= (times >= start) & (times < stop)
+        return result
+
+    def restrict(self, intervals):
+        intervals = np.asarray(intervals, float).reshape(-1, 2)
+        if self.intervals is None:
+            return intervals.copy()
+        result = []
+        for start, stop in intervals:
+            for observed_start, observed_stop in self.intervals:
+                left, right = (
+                    max(start, observed_start),
+                    min(stop, observed_stop),
+                )
+                if right > left:
+                    result.append([left, right])
+        return np.asarray(result, float).reshape(-1, 2)
+
+
+class Relation:
+    def __init__(self, data, key=None):
+        self.data = data
+        self.key = key
+
+    def __and__(self, key):
+        return Relation(self.data, key)
+
+    def fetch1(self, *args):
+        if self.key is not None and "interval_list_name" in self.key:
+            return self.data[self.key["interval_list_name"]]
+        return self.data
+
+
+class AdapterCaptured(Exception):
+    pass
+
+
+def capture_make(
+    migration,
+    tracking,
+    spikes,
+    params,
+    *,
+    kwargs=None,
+    observation_intervals=None,
+    encoding_intervals=((0.0, 1.0),),
+    decoding_intervals=((0.0, 1.0),),
+    estimate=False,
+):
+    method = migration.source_method(
+        "sorted_spikes.py", "SortedSpikesDecodingV1", "make"
+    )
+    method.__globals__.update(
+        {
+            "copy": copy,
+            "pd": pd,
+            "DecodingParameters": Relation(
+                {"decoding_params": params, "decoding_kwargs": kwargs}
+            ),
+            "IntervalList": Relation(
+                {
+                    "encoding": np.asarray(encoding_intervals, float),
+                    "decoding": np.asarray(decoding_intervals, float),
+                }
+            ),
+            "SortedSpikesGroup": SimpleNamespace(
+                get_observation_intervals=lambda *a, **k: Observation(
+                    observation_intervals
+                )
+            ),
+        }
+    )
+    captured = {}
+
+    def capture(**values):
+        captured.update(values)
+        raise AdapterCaptured
+
+    table = SimpleNamespace(
+        fetch_position_info=lambda key: (tracking, ["position"]),
+        fetch_spike_data=lambda *a, **k: (spikes, [1]),
+        _run_decoder=capture,
+    )
+    key = {
+        "decoding_param_name": "probe",
+        "nwb_file_name": "probe.nwb",
+        "encoding_interval": "encoding",
+        "decoding_interval": "decoding",
+        "estimate_decoding_params": estimate,
+    }
+    try:
+        method(table, key)
+    except AdapterCaptured:
+        pass
+    assert captured, "make never reached the decoder"
+    return captured
+
+
+def run_captured_adapter(migration, captured):
+    return migration.run_adapter(
+        "sorted",
+        captured["key"]["estimate_decoding_params"],
+        captured["position_info"],
+        captured["spike_times"],
+        None,
+        captured["decoding_params"],
+        captured["decoding_kwargs"],
+        captured["decoding_interval"],
+    )
